# Supabase (Fase 0 -- crea un progetto su supabase.com e incolla qui i valori veri in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # MAI esposta al browser, solo lato server/Edge Function

# Stripe (Fase 5 -- collegata l'11/09/2026, account sandbox "Sandbox di Via
# gambarelli 31"). Chiavi da Dashboard Stripe -> Developers -> API keys
# (modalita' TEST finche' non c'e' un account live pronto per i pagamenti
# veri, vedi DECISIONS.md sulla Partita IVA). STRIPE_WEBHOOK_SECRET viene
# invece da Developers -> Webhooks -> il tuo endpoint -> "Signing secret",
# dopo aver creato l'endpoint (vedi commento in
# src/app/api/stripe/webhook/route.ts per quali eventi ascoltare).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price ID dei 3 piani a pagamento (Dashboard Stripe -> Product catalog ->
# crea prodotto -> prezzo ricorrente mensile in EUR -> copia il Price ID,
# formato "price_..."). Free non ha un prezzo Stripe (gestito solo nel
# nostro DB), Enterprise e' a preventivo (nessun checkout self-service).
STRIPE_PRICE_STARTER=   # EUR 19,90/mese
STRIPE_PRICE_GROWTH=    # EUR 39,90/mese
STRIPE_PRICE_PRO=       # EUR 69,90/mese

# AI (gia' in uso nel progetto precedente, stesso valore)
ANTHROPIC_API_KEY=

# WhatsApp -- canale "connetti il tuo numero" per-salone via Meta Embedded
# Signup (vedi docs/embedded-signup-whatsapp.md). WHATSAPP_APP_ID/APP_SECRET
# sono quelli della NOSTRA app Meta (una sola coppia per tutta la piattaforma,
# non per cliente) -- non utilizzabili finche' business verification + App
# Review non sono completati. WHATSAPP_VERIFY_TOKEN e' una stringa scelta da
# noi, usata solo per la verifica iniziale del webhook.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=   # id della configurazione "Facebook Login for Business"
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false # mettere "true" solo quando l'app Meta e' pronta

# Google Calendar (Fase 6bis, deciso il 02/09/2026: OAuth2 per-operatore, non
# un service account -- ogni operatore autorizza il collegamento al SUO
# calendario personale, non un calendario condiviso della piattaforma).
# GOOGLE_CLIENT_ID/SECRET vengono da un progetto Google Cloud con Calendar API
# abilitata + schermata di consenso OAuth configurata (vedi PIANO.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendario/google/callback

# Resend (Fase 6, notifiche email -- 13/09/2026, Gruppo B-bis #1 di PIANO.md).
# Crea un account gratis su resend.com (3.000 email/mese gratis, nessuna
# approvazione esterna richiesta a differenza di WhatsApp) -> Dashboard ->
# API Keys -> crea chiave -> incollala qui. Senza questa chiave l'intero
# modulo email resta silenziosamente disattivato (fail-open by design, vedi
# src/lib/email/resend.server.ts): nessuna prenotazione si blocca, semplicemente
# non parte nessuna email. RESEND_FROM_EMAIL e' opzionale finche' non verifichi
# un dominio tuo su Resend (Dashboard -> Domains): senza dominio verificato si
# puo' comunque inviare con l'indirizzo di test "onboarding@resend.dev", ma
# SOLO verso l'email con cui ti sei registrato su Resend -- per mandare
# davvero ai clienti serve un dominio verificato + questa variabile impostata
# (es. "Salone AI <notifiche@tuodominio.it>").
RESEND_API_KEY=
RESEND_FROM_EMAIL=
