# Supabase (Fase 0 -- crea un progetto su supabase.com e incolla qui i valori veri in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # MAI esposta al browser, solo lato server/Edge Function

# Stripe (Fase 5 -- collegata l'11/09/2026, account sandbox "Sandbox di Via
# gambarelli 31"). Chiavi da Dashboard Stripe -> Developers -> API keys
# (modalita' TEST finche' non c'e' un account live pronto per i pagamenti
# veri, vedi DECISIONS.md sulla Partita IVA). STRIPE_WEBHOOK_SECRET viene
# invece da Developers -> Webhooks -> il tuo endpoint -> "Signing secret",
# dopo aver creato l'endpoint (vedi commento in
# src/app/api/stripe/webhook/route.ts per quali eventi ascoltare).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price ID dei 3 piani a pagamento (Dashboard Stripe -> Product catalog ->
# crea prodotto -> prezzo ricorrente mensile in EUR -> copia il Price ID,
# formato "price_..."). Free non ha un prezzo Stripe (gestito solo nel
# nostro DB), Enterprise e' a preventivo (nessun checkout self-service).
STRIPE_PRICE_STARTER=   # EUR 19,90/mese
STRIPE_PRICE_GROWTH=    # EUR 39,90/mese
STRIPE_PRICE_PRO=       # EUR 89,90/mese (include 1 operatore)

# Secondo line item "operatore extra", su TUTTI E TRE i piani a pagamento
# (esteso a Starter/Growth il 16/09/2026; dal 14/09/2026 al 16/09/2026 era
# solo su Pro -- vedi priceIdOperatoreExtra in src/lib/stripe/piani.ts e
# DECISIONS.md). Il prezzo base di ogni piano include 1 operatore, ognuno
# oltre il primo costa la cifra qui sotto. Prodotto/Price SEPARATO dal Price
# base, non una fascia di quantita' sullo stesso Price.
# Applicato automaticamente al checkout (/api/stripe/checkout) e tenuto
# sincronizzato quando gli operatori cambiano
# (src/lib/stripe/operatori.server.ts), che sa anche SOSTITUIRE la riga
# quando un salone cambia piano.
# Se una di queste variabili manca, quel piano semplicemente non applica la
# quota (nessun errore): il codice e' gia' pronto, si attiva quando il Price
# esiste su Stripe.
STRIPE_PRICE_STARTER_OPERATORE_EXTRA=   # EUR 10,00/mese
STRIPE_PRICE_GROWTH_OPERATORE_EXTRA=    # EUR 15,00/mese
STRIPE_PRICE_PRO_OPERATORE_EXTRA=       # EUR 20,00/mese

# AI (gia' in uso nel progetto precedente, stesso valore)
ANTHROPIC_API_KEY=

# WhatsApp -- canale "connetti il tuo numero" per-salone via Meta Embedded
# Signup (vedi docs/embedded-signup-whatsapp.md). WHATSAPP_APP_ID/APP_SECRET
# sono quelli della NOSTRA app Meta (una sola coppia per tutta la piattaforma,
# non per cliente) -- non utilizzabili finche' business verification + App
# Review non sono completati. WHATSAPP_VERIFY_TOKEN e' una stringa scelta da
# noi, usata solo per la verifica iniziale del webhook.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=   # id della configurazione "Facebook Login for Business"
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false # mettere "true" solo quando l'app Meta e' pronta

# Google Calendar (Fase 6bis, deciso il 02/09/2026: OAuth2 per-operatore, non
# un service account -- ogni operatore autorizza il collegamento al SUO
# calendario personale, non un calendario condiviso della piattaforma).
# GOOGLE_CLIENT_ID/SECRET vengono da un progetto Google Cloud con Calendar API
# abilitata + schermata di consenso OAuth configurata (vedi PIANO.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendario/google/callback

# Mailjet (Fase 6, notifiche email -- 13/09/2026, Gruppo B-bis #1 di PIANO.md).
# Piano gratis 6.000 email/mese (200/giorno), nessuna approvazione esterna
# richiesta a differenza di WhatsApp. MJ_APIKEY_PUBLIC/MJ_APIKEY_PRIVATE
# vengono da Account -> API Key Management (la "Primary API Key", oppure una
# subaccount key dedicata -- entrambe funzionano, una subaccount key isola
# meglio le statistiche di questo progetto dal resto del tuo account).
# Senza queste due chiavi l'intero modulo email resta silenziosamente
# disattivato (fail-open by design, vedi src/lib/email/mailjet.server.ts):
# nessuna prenotazione si blocca, semplicemente non parte nessuna email.
#
# MAILJET_FROM_EMAIL e' invece OBBLIGATORIA fin da subito (a differenza di
# Resend, Mailjet non ha un indirizzo di test universale): deve essere un
# indirizzo che hai validato dal pannello Mailjet (Account -> Sender
# addresses & domains -> Add a sender address -> conferma il click nella
# email che ti manda Mailjet, un minuto). Senza validarlo, ogni invio fallisce
# silenziosamente con "Unauthorized sender" (fail-open: nessuna prenotazione
# si rompe, ma nessuna email parte).
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAILJET_FROM_EMAIL=

# Promemoria automatici (Fase 6, 14/09/2026 -- vedi src/lib/promemoria.ts).
# CRON_SECRET e' una stringa a caso scelta da noi (non un token di terzi),
# generata una volta e incollata anche nelle impostazioni del Cron Job su
# Vercel: protegge /api/cron/promemoria da chiunque altro provasse a
# chiamarlo (manderebbe email vere a clienti veri se fosse pubblico).
# Genera un valore con: openssl rand -hex 32
CRON_SECRET=

# SMS via Skebby (Fase 5+SMS, 14/09/2026 -- vedi DECISIONS.md per il confronto
# con Twilio/WhatsApp Business Platform). Canale di FALLBACK su Pro/Enterprise
# quando un cliente non ha lasciato un'email (mai in aggiunta), sia per la
# conferma di prenotazione (notifiche.server.ts) sia per i Promemoria
# automatici (promemoria.server.ts) -- vedi src/lib/sms/skebby.server.ts.
# SKEBBY_EMAIL/SKEBBY_PASSWORD sono le credenziali di login del pannello
# Skebby (non una API key separata -- l'autenticazione REST usa direttamente
# queste due, vedi GET /token nella documentazione Skebby). Senza queste due
# variabili l'intero modulo SMS resta silenziosamente disattivato (fail-open
# by design, stesso principio di MJ_APIKEY_PUBLIC/PRIVATE sopra): nessuna
# prenotazione si blocca, semplicemente non parte nessun SMS (il cliente
# senza email semplicemente non riceve nulla, come oggi).
SKEBBY_EMAIL=
SKEBBY_PASSWORD=
